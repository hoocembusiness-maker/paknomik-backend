# Paknomik backend — example configuration. Never commit real values.
# Copy to `.env` and fill in locally or from the hosting secret manager.

BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ── Django / Railway ──────────────────────────────────────────────────────
# Local development keeps SQLite. Set DATABASE_URL only for PostgreSQL
# (Railway injects it when the Postgres plugin is linked).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_PROXY_SSL_HEADER=false
# Persistent volume path on Railway, for example /data/media. Leave empty locally.
MEDIA_ROOT=
# true only when MEDIA_ROOT is a persistent volume. The Railway disk is ephemeral.
DJANGO_SERVE_MEDIA=false
DJANGO_LOG_LEVEL=INFO

# ── Email (HTTPS via Resend; SMTP is blocked on Railway Hobby) ────────────
# Local default is the console backend (emails print in the terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Paknomik <no_reply@paknomik.com>
# Optional SMTP leftover (unused when RESEND_API_KEY is set):
EMAIL_HOST=mail.spacemail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=no_reply@paknomik.com
EMAIL_HOST_PASSWORD=
PASSWORD_RESET_TIMEOUT=1800
PASSWORD_RESET_EMAIL_COOLDOWN=120
# Reset emails use FRONTEND_URL above. Production must be https://paknomik.com

# ── Présence digitale (docs/presence-digitale.md) ─────────────────────────
# Public base URL of the app (used to validate redirect URIs and to
# send the user back to the dashboard after OAuth).
APP_BASE_URL=http://localhost:5173

# One or more Fernet keys separated by commas (the first one encrypts, the
# others still decrypt, for rotation). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Meta — Facebook Login for Business (Facebook Pages)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/meta/callback/
META_GRAPH_API_VERSION=v26.0
# Only enable if PKCE is turned on for the Meta app.
META_USE_PKCE=false

# Meta — Instagram API with Instagram Login (separate app/flow, separate tokens)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/instagram/callback/

# Google — GA4 Data API + Search Console (minimal read-only scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/google/callback/

# Minimum delay between two manual syncs of the same connection.
DIGITAL_MANUAL_SYNC_COOLDOWN_MINUTES=15
